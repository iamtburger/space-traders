# Provider API keys — only set the one(s) matching the model(s) you plan to run.
# Models are specified as "provider:modelId" (e.g. "anthropic:claude-haiku-4-5-20251001",
# "openai:gpt-4o-mini"). See src/server/agent/providers.ts to add another provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# SpaceTraders agent token. Get one with: npm run register-agent -- <callsign>
SPACETRADERS_TOKEN=

# Optional overrides (defaults shown)
PORT=3000
DEFAULT_MODEL=anthropic:claude-haiku-4-5-20251001
DEFAULT_MAX_STEPS=25
DB_PATH=data/journal.sqlite
